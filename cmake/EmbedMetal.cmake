# Concatenate Metal Shading Language sources into a C++ header (compiled at runtime by Metal).
# Local includes ('#include "..."') are dropped: the files are passed in dependency order.
# usage: cmake -DOUT=<header> -DIN=<file1|file2|...> -DIN_CP=<file1|...> -P EmbedMetal.cmake
#   IN    -> kMetalSource   (spectral operators)
#   IN_CP -> kMetalSourceCP (constitutive update, compiled separately on first use)
function(embed var list result)
  string(REPLACE "|" ";" files "${list}")
  set(content "")
  foreach(f IN LISTS files)
    file(READ ${f} c)
    string(REGEX REPLACE "#include \"[^\"]*\"" "" c "${c}")
    string(APPEND content "// ---- ${f}\n${c}\n")
  endforeach()
  set(${result} "static const char ${var}[] = R\"DAMASKMSL(\n${content})DAMASKMSL\";\n" PARENT_SCOPE)
endfunction()

embed(kMetalSource   "${IN}"    spectral)
embed(kMetalSourceCP "${IN_CP}" cp)
file(WRITE ${OUT} "// generated by cmake/EmbedMetal.cmake, do not edit\n${spectral}${cp}")
